# LifeStack Backend Environment Configuration
# Copy this file to .env and adjust variables as needed

# Server Port
PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lifestack_db
DB_USERNAME=postgres
DB_PASSWORD=root
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# Application Security (Prepared for Milestone 2)
APP_SESSION_SECRET=change-me-to-a-very-secure-random-secret-key-at-least-32-chars
APP_SESSION_MAX_AGE_SECONDS=604800

# Client Application URL (for CORS and redirects)
CLIENT_APP_URL=http://localhost:5173

