# ==============================================================================
# LifeStack Frontend — Environment Configuration Template
# ==============================================================================

# Application Branding
VITE_APP_TITLE=LifeStack

# ------------------------------------------------------------------------------
# API Backend Base URL
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT (uses Vite reverse-proxy to localhost:8080):
VITE_API_BASE_URL=/api/v1

# CLOUD HOSTING (Vercel pointing to Render Backend):
# VITE_API_BASE_URL=https://your-backend-name.onrender.com/api/v1
